# Maintainer: 896kb <raducugarjoaba at gmail dot com>
pkgname=air-gestures-bin
_pkgname=air-gestures
pkgver=0.3.9
pkgrel=1
pkgdesc='Control a Linux desktop with a Meta Neural Band (daemon, CLI, waybar module)'
arch=('x86_64' 'aarch64')
url='https://gitlab.com/896kb/air-gestures'
license=('MIT')
depends=('bluez' 'dbus' 'webkit2gtk-4.1' 'gtk3' 'libsoup3' 'glib2' 'cairo' 'gdk-pixbuf2' 'gcc-libs' 'glibc')
provides=("$_pkgname")
conflicts=("$_pkgname")
options=('!debug')
source_x86_64=("$_pkgname-$pkgver-x86_64-linux.tar.gz::$url/-/releases/v$pkgver/downloads/$_pkgname-x86_64-linux.tar.gz")
source_aarch64=("$_pkgname-$pkgver-aarch64-linux.tar.gz::$url/-/releases/v$pkgver/downloads/$_pkgname-aarch64-linux.tar.gz")
sha256sums_x86_64=('c71aa7e0ce3454c911adab9a37d8a3691f9df506fb2acbd2bb5dbfed4bbe65ac')
sha256sums_aarch64=('9ba1e225b6f64dff4302d294733585383cddd8943b72953c7f98224b13932b80')

package() {
  cd "$_pkgname-v$pkgver"
  install -Dm755 -t "$pkgdir/usr/bin" air-gestures air-gesturesd
  install -Dm644 air-gesturesd.service "$pkgdir/usr/lib/systemd/user/air-gesturesd.service"
  install -Dm644 config.toml "$pkgdir/usr/share/$_pkgname/config.toml"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$_pkgname/README.md"
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE LICENSE-kinesis
}
